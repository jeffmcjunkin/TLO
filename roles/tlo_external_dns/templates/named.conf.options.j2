// {{ ansible_managed }}
// Forwards everything outside the authoritative zone.
options {
    directory "/var/cache/bind";

    // Recursive resolver for clients, forwarding upstream.
    recursion yes;
    allow-recursion { any; };
    allow-query { any; };
    forwarders {
{% for fwd in dns_forwarders %}
        {{ fwd }};
{% endfor %}
    };
    forward only;

    // Don't fail resolution on forwarder DNSSEC quirks.
    dnssec-validation no;

    allow-transfer { any; };

    listen-on { any; };
    listen-on-v6 { none; };
};
