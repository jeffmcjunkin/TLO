; {{ ansible_managed }}
; Authoritative zone for {{ dns_zone }}
; ns1 = {{ tlo_dns_ip }}
$TTL {{ dns_ttl }}
@       IN      SOA     {{ dns_ns_name }}.{{ dns_zone }}. {{ dns_hostmaster }} (
                        {{ dns_soa_serial }}    ; Serial
                        {{ dns_soa_refresh }}   ; Refresh
                        {{ dns_soa_retry }}     ; Retry
                        {{ dns_soa_expire }}    ; Expire
                        {{ dns_soa_minimum }} ) ; Negative cache TTL

; --- Name servers ---
@                       IN      NS      {{ dns_ns_name }}.{{ dns_zone }}.
{{ dns_ns_name }}       IN      A       {{ tlo_dns_ip }}

; --- Mail (decoy) ---
@                       IN      MX      10 mail.{{ dns_zone }}.
@                       IN      TXT     "v=spf1 mx a:mail.{{ dns_zone }} -all"

; --- Host records ---
{% for rec in tlo_dns_a_records %}
{{ "%-23s"|format(rec.name) }} IN      A       10.{{ tlo_range_octet }}.{{ rec.octets }}      ; {{ rec.comment }}
{% endfor %}
{% for rec in tlo_dns_extra_records %}
{{ "%-23s"|format(rec.name) }} IN      {{ rec.type }}      {{ rec.value }}
{% endfor %}
