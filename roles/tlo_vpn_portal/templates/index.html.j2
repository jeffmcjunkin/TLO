<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CorpVPN Portal — vpn01.tlo-corp.local</title>
  <style>
    body { font-family: -apple-system, Segoe UI, Roboto, Arial, sans-serif; background:#0e1726; color:#e6edf3; margin:0; }
    header { background:#132a4d; padding:22px 32px; border-bottom:3px solid #2f6feb; }
    header h1 { margin:0; font-size:20px; letter-spacing:.5px; }
    header .sub { color:#8aa0bd; font-size:12px; margin-top:4px; }
    main { max-width:720px; margin:36px auto; padding:0 24px; }
    .card { background:#111b2e; border:1px solid #22314d; border-radius:10px; padding:24px 28px; margin-bottom:20px; }
    .card h2 { margin-top:0; font-size:15px; color:#9fc0ff; text-transform:uppercase; letter-spacing:1px; }
    a.dl { display:inline-block; background:#2f6feb; color:#fff; text-decoration:none; padding:11px 20px; border-radius:6px; font-weight:600; }
    a.dl:hover { background:#3d7dfd; }
    code { background:#0b1220; padding:2px 6px; border-radius:4px; color:#7ee787; }
