# {{ ansible_managed }}
# TLO override of HardHat C2's compose: expose the teamserver (implant/API) and the
# Blazor client UI on all interfaces so the range (Kali operator, ALPHA implants) can
# reach them. Builds from the repo's own Dockerfiles. Pinned ref: {{ hardhat_version }}.
version: "3"
services:
  hardhat-server:
    build:
      context: .
      dockerfile: ./docker/server/Dockerfile
    image: hardhat_server
    container_name: hardhat_server
    restart: unless-stopped
    ports:
      - "0.0.0.0:{{ hardhat_teamserver_port }}:5000"
    volumes:
      - ./downloads:/app/TeamServer/Downloads
      - ./logs:/app/TeamServer/logs
      - certs:/app/TeamServer/Certificates
      - db:/app/TeamServer/database
      - keys_server:/root/.aspnet/DataProtection-Keys
      - wwwroot:/app/TeamServer/wwwroot

  hardhat-client:
    build:
      context: .
      dockerfile: ./docker/client/Dockerfile
    image: hardhat_client
    container_name: hardhat_client
    depends_on:
      - hardhat-server
    restart: unless-stopped
    ports:
      - "0.0.0.0:{{ hardhat_ui_port }}:7096"
    volumes:
      - ./logs:/app/HardHatC2Client/logs
      - keys_client:/root/.aspnet/DataProtection-Keys

volumes:
  certs:
  db:
  keys_client:
  keys_server:
  wwwroot:
