# {{ ansible_managed }}
# CorpVPN — OpenVPN server
# VPN clients get 172.16.20.0/24, are pushed the CHARLIE route, and are SNAT'd
# out {{ tlo_vlan20_nic }} so they can reach VLAN {{ vpn_charlie_vlan }}.
port {{ vpn_port }}
proto {{ vpn_proto }}
dev {{ vpn_dev }}

ca {{ easyrsa_dir }}/pki/ca.crt
cert {{ easyrsa_dir }}/pki/issued/server.crt
key {{ easyrsa_dir }}/pki/private/server.key
dh {{ easyrsa_dir }}/pki/dh.pem
tls-crypt {{ ovpn_server_dir }}/ta.key

# topology subnet -> a single IP per client out of the pool (spec requirement)
topology subnet
server {{ vpn_server_network }} {{ vpn_server_netmask }}
ifconfig-pool-persist {{ ovpn_server_dir }}/ipp.txt

# Push the route into CHARLIE (VLAN {{ vpn_charlie_vlan }}). Without the tunnel the
# client has no route to {{ tlo_charlie_net }}/24 at all.
push "route {{ tlo_charlie_net }} 255.255.255.0"
{% if vpn_push_dns %}
push "dhcp-option DNS {{ vpn_push_dns }}"
{% endif %}

keepalive 10 120
cipher AES-256-GCM
data-ciphers AES-256-GCM:AES-128-GCM
auth SHA256
tls-version-min 1.2
persist-key
persist-tun
user nobody
group nogroup
{% if vpn_proto == 'udp' %}
explicit-exit-notify 1
{% endif %}
status {{ ovpn_server_dir }}/openvpn-status.log
log-append /var/log/openvpn.log
verb 3
