<?xml version="1.0" encoding="utf-8"?>
<!-- CorpShop training app — intentionally insecure configuration (isolated lab only). -->
<configuration>
  <connectionStrings>
    <add name="AppDb"
         connectionString="Server={{ oscar_web_db_host }};Database={{ oscar_web_db_name }};User Id={{ oscar_web_db_user }};Password={{ oscar_web_db_password }};"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" />
    <!-- Deliberately static machineKey (Milestone 5.1 ViewState practice). No per-session
         ViewStateUserKey, so a holder of this key can forge __VIEWSTATE. -->
    <machineKey validation="SHA1" decryption="AES"
                validationKey="{{ oscar_web_validation_key }}"
                decryptionKey="{{ oscar_web_decryption_key }}" />
    <authentication mode="Forms" />
    <customErrors mode="Off" />
  </system.web>
</configuration>
