# {{ ansible_managed }}
# CorpVPN remote-access portal (nginx). Serves and lists the client profile.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name {{ portal_server_name }};

    ssl_certificate     /etc/ssl/certs/corpvpn.crt;
    ssl_certificate_key /etc/ssl/private/corpvpn.key;

    server_tokens on;
    add_header X-Powered-By "{{ portal_header_powered_by }}" always;
    add_header X-Backend "{{ portal_header_backend }}" always;

    root {{ web_root }};
    index index.html;

    # HTTP Basic authentication.
    auth_basic "CorpVPN Portal - Authentication Required";
    auth_basic_user_file /etc/nginx/.htpasswd;

    location = / {
        try_files /index.html =404;
    }

    # Serve the client profile as a download.
    location = /client.ovpn {
        alias {{ web_root }}/client.ovpn;
        default_type application/x-openvpn-profile;
        add_header Content-Disposition 'attachment; filename="client.ovpn"';
        # add_header inside a location resets inherited headers — re-add the leaks.
        add_header X-Powered-By "{{ portal_header_powered_by }}" always;
        add_header X-Backend "{{ portal_header_backend }}" always;
    }

    # Directory listing for client profiles.
    location /downloads/ {
        alias {{ web_root }}/downloads/;
        autoindex on;
        add_header X-Powered-By "{{ portal_header_powered_by }}" always;
        add_header X-Backend "{{ portal_header_backend }}" always;
    }
}
