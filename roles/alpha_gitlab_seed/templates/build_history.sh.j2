#!/usr/bin/env bash
# =====================================================================
# Offline git-history builder for alpha/payment-service.
# Assembles the repo history and pushes it over HTTP with the PAT.
# Rendered by Ansible (Jinja has already substituted the values below).
# =====================================================================
set -euo pipefail

BUILD_DIR="{{ alpha_gitlab_build_dir }}"
REPO_URL="http://oauth2:{{ alpha_gitlab_pat }}@127.0.0.1/{{ alpha_gitlab_group }}/{{ alpha_gitlab_project }}.git"
API="http://127.0.0.1/api/v4"
PROJ="{{ alpha_gitlab_group | urlencode }}%2F{{ alpha_gitlab_project | urlencode }}"
PAT="{{ alpha_gitlab_pat }}"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

git init -q -b main
git config user.email "devuser@alpha.local"
git config user.name  "Dev User"

# ---------- commit 1: clean skeleton ----------
mkdir -p config src scripts
cat > README.md <<'EOF'
# payment-service

Internal payment processing microservice (ALPHA). Built by the TeamCity CI pipeline
on XY1-ALPHA. See `.gitlab-ci.yml` for the build/deploy stages.
EOF
cat > src/Program.cs <<'EOF'
using System;
namespace PaymentService {
    public static class Program {
        public static void Main() => Console.WriteLine("payment-service");
    }
}
EOF
git add -A
git commit -q -m "Initial import of payment-service"

# ---------- commit 2: add production DB config + CI token ----------
cat > config/database.yml <<'EOF'
production:
  adapter:  sqlserver
  host:     {{ alpha_prod_db_host }}
  database: {{ alpha_prod_db_name }}
  username: {{ alpha_prod_db_user }}
  password: "{{ alpha_prod_db_password }}"

# CI deploy token used by scripts/deploy.sh (TODO: move to a secret store)
CI_API_TOKEN: "{{ alpha_gitlab_pat }}"
EOF
cat > scripts/deploy.sh <<'EOF'
#!/usr/bin/env bash
# deploy using the CI token from config/database.yml
curl --header "PRIVATE-TOKEN: ${CI_API_TOKEN}" "https://gitlab.alpha.local/api/v4/projects"
EOF
git add -A
git commit -q -m "Add production database config and deploy helper"

# ---------- commit 3: refund handler skeleton ----------
cat > src/Refund.cs <<'EOF'
namespace PaymentService { public static class Refund { } }
EOF
git add -A
git commit -q -m "Add refund handler skeleton"

# ---------- commit 4: move secrets to environment variables ----------
cat > config/database.yml <<'EOF'
production:
  adapter:  sqlserver
  host:     <%= ENV['PROD_DB_HOST'] %>
  database: <%= ENV['PROD_DB_NAME'] %>
  username: <%= ENV['PROD_DB_USER'] %>
  password: <%= ENV['PROD_DB_PASSWORD'] %>
EOF
cat > scripts/deploy.sh <<'EOF'
#!/usr/bin/env bash
# deploy using the CI token from the environment (no longer hardcoded)
curl --header "PRIVATE-TOKEN: ${CI_API_TOKEN}" "https://gitlab.alpha.local/api/v4/projects"
EOF
git add -A
git commit -q -m "Move DB password and API token to environment variables (security)"

# ---------- commit 5: add .gitlab-ci.yml ----------
cat > .gitlab-ci.yml <<'EOF'
stages:
  - build
  - deploy

build:
  stage: build
  script:
    - echo "Building payment-service"
    - dotnet build -c Release || true

deploy:
  stage: deploy
  script:
    - echo "Deploying to $PROD_DB_HOST"
    - echo "$PROD_DB_PASSWORD" | base64
    - echo "$AWS_SECRET_KEY"   | base64
    - echo "$DEPLOY_SSH_KEY"   | base64 -d > /tmp/deploy_key
  only:
    - main
EOF
git add -A
git commit -q -m "Add GitLab CI pipeline"

# ---------- push ----------
# GitLab's default-branch protection denies *force*-push to main (even the initial
# one on a fresh repo), but the owner PAT may do a normal push to create it. So push
# normally first; only on a re-run (branch exists / non-fast-forward) do we relax the
# force-push protection via the API and force the rewritten history through.
if ! git push -q "$REPO_URL" main 2>/dev/null; then
  echo "normal push rejected (re-run) — enabling force-push on main, then forcing"
  curl -s -o /dev/null --request PATCH \
    "$API/projects/$PROJ/protected_branches/main?allow_force_push=true" \
    --header "PRIVATE-TOKEN: $PAT" || true
  git push -q -f "$REPO_URL" main
fi
echo "pushed history to {{ alpha_gitlab_group }}/{{ alpha_gitlab_project }}"
