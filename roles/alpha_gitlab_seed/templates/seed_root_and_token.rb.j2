# gitlab-rails runner — set a known root password + mint a DETERMINISTIC PAT.
# Executed on the GitLab host by:  gitlab-rails runner /tmp/seed_root_and_token.rb
# Prints "CHANGED" only when it actually creates the token (drives Ansible changed_when).
# Only gitlab-rails can force a specific token value (set_token); the REST API cannot.
# Ref: https://docs.gitlab.com/security/tokens/#personal-access-tokens

changed = false

root = User.find_by_username('root')
if root
  root.password = '{{ alpha_gitlab_root_password }}'
  root.password_confirmation = '{{ alpha_gitlab_root_password }}'
  root.password_automatically_set = false
  # skip validations so the password is accepted regardless of pw policy
  root.save!(validate: false)
end

pat_value = '{{ alpha_gitlab_pat }}'
unless PersonalAccessToken.find_by_token(pat_value)
  t = root.personal_access_tokens.build(
    scopes: %w[api read_repository write_repository sudo],
    name: '{{ alpha_gitlab_pat_name }}',
    expires_at: 365.days.from_now.to_date
  )
  t.set_token(pat_value)   # force the exact glpat- value used elsewhere
  t.save!(validate: false)
  changed = true
end

puts(changed ? 'CHANGED' : 'OK')
